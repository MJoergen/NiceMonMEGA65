# The screen's registers, src/scr_regs.vhd (formal_scr_regs.vhd). "prove"
# proves the assertions for every cycle by k-induction, and "cover" reaches
# each cover statement. The depths are in cycles: 4 is the k of the
# induction, and 10 is how far "cover" looks for each statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 10

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl scr_regs.vhd formal_scr_regs.vhd -e formal_scr_regs
prep -top formal_scr_regs

[files]
../src/scr_regs.vhd
formal_scr_regs.vhd
