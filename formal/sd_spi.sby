# The protocol engine of the SD card controller, src/sd/sd_spi.vhd
# (formal_sd_spi.vhd), with its byte shifter, sd_spi_byte.vhd. "prove"
# proves the assertions for every cycle by k-induction, and "cover" reaches
# each cover statement. The depths are in cycles: 8 is the k of the
# induction, and 40 is how far "cover" looks for each statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 40

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl sd_spi_byte.vhd sd_spi.vhd formal_sd_spi.vhd -e formal_sd_spi
prep -top formal_sd_spi

[files]
../src/sd/sd_spi_byte.vhd
../src/sd/sd_spi.vhd
formal_sd_spi.vhd
