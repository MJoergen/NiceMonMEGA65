# The command line interpreter, the line buffer and cmd.vhd
# (formal_cli.vhd). "prove" proves the assertions for every cycle by
# k-induction, and "cover" reaches each cover statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl line_buffer.vhd cmd.vhd formal_cli.vhd -e formal_cli
prep -top formal_cli

[files]
../src/line_buffer.vhd
../src/cmd.vhd
formal_cli.vhd
