# The debugger's adapter to the debug link's side port, src/dbg/dbg_host.vhd
# (formal_dbg_host.vhd). "prove" proves the assertions for every cycle by
# k-induction, and "cover" reaches each cover statement. The depths are in
# cycles: 6 is the k of the induction, and 16 is how far "cover" looks,
# past a read of three words.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 16

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl dbg_host.vhd formal_dbg_host.vhd -e formal_dbg_host
prep -top formal_dbg_host

[files]
../src/dbg/dbg_host.vhd
formal_dbg_host.vhd
