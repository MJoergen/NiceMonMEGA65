# The debugger's host in hardware, src/dbg/dbg_host.vhd
# (formal_dbg_host.vhd). "prove" proves the assertions for every cycle by
# k-induction, and "cover" reaches each cover statement. The depths are in
# cycles: 8 is the k of the induction, and 30 is how far "cover" looks,
# past a W of 25 bytes.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 30

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl dbg_host.vhd formal_dbg_host.vhd -e formal_dbg_host
prep -top formal_dbg_host

[files]
../src/dbg/dbg_host.vhd
formal_dbg_host.vhd
