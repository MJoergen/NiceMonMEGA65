# The arbiter of the Ethernet station's frames to send, src/eth/eth_arb.vhd
# (formal_eth_arb.vhd). "prove" proves the assertions for every cycle by
# k-induction, and "cover" reaches each cover statement. The depths are in
# cycles: 4 is the k of the induction, and 10 is how far "cover" looks.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 10

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl eth_arb.vhd formal_eth_arb.vhd -e formal_eth_arb
prep -top formal_eth_arb

[files]
../src/eth/eth_arb.vhd
formal_eth_arb.vhd
