# The whole system (formal_nicemon.vhd), with the checks of nicemon.vhd. It
# is too large for k-induction, so "run" and "link" check every cycle up to
# their depth: "run" with the core running from reset, "link" with the core
# held first, for the link. "cover" reaches each cover statement. These
# three have no ROM and no board registers. "rom" and "rom_cover" are "run"
# and "cover" with both: a ROM of 4 words, rom.bin, and the Nexys4DDR's
# registers at 0xFFFFFF90-9F.
# The core is nice_core_formal.vhd, a free core that does anything either
# of nice_cpu's cores may do on its ports, so the system is checked against
# both, and the solver spends nothing on a real core's state. The debug
# link is debug_link_formal.vhd, a free link that does anything that
# nice_cpu's debug_link.vhd may do, so it makes a request in any cycle,
# where a real one needs hundreds of cycles of UART bytes for one. Its
# assumptions are the contracts of debug_link.vhd, which nice_cpu proves
# in nice_cpu/hdl/formal/debug_link.sby.
# The link uses the bus only while the core is held or halted, and a
# halted core has no bus cycle open, so no link request meets a running core
# or an outstanding fetch.
# "sd" and "sd_cover" are "run" and "cover" with the SD card controller
# at 0xFFFFFFA0-AF, in the boards' configuration: two slots, without
# G_SD_HOLD_ACK, so that it never stalls.
# The depths are in cycles: "run", "rom", and "sd" check 30, "link" checks
# 40, and "cover", "rom_cover", and "sd_cover" look 40 cycles for each
# statement.
# The ghdl lines differ only in generics. G_CPU_RUN_AT_RESET is true in
# "run", "cover", "rom", "rom_cover", "sd", and "sd_cover", and false in
# "link". "rom" and "rom_cover" also set G_ROM_FILE=rom.bin and
# G_BOARD_IO=true, and "sd" and "sd_cover" set G_SD_SLOTS=2.

[tasks]
run
link
cover
rom
rom_cover
sd
sd_cover

[options]
run: mode bmc
run: depth 30
link: mode bmc
link: depth 40
cover: mode cover
cover: depth 40
rom: mode bmc
rom: depth 30
rom_cover: mode cover
rom_cover: depth 40
sd: mode bmc
sd: depth 30
sd_cover: mode cover
sd_cover: depth 40

[engines]
smtbmc yices

[script]
plugin -i ghdl
run: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd tod.vhd timer.vhd fetch_stats.vhd sd_regs.vhd net_regs.vhd eth_regs.vhd sd_spi_byte.vhd sd_spi.vhd sd.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd uart_pkg.vhd bus_pkg.vhd board_io.vhd scr_regs.vhd devices.vhd mem.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
link: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=false nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd tod.vhd timer.vhd fetch_stats.vhd sd_regs.vhd net_regs.vhd eth_regs.vhd sd_spi_byte.vhd sd_spi.vhd sd.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd uart_pkg.vhd bus_pkg.vhd board_io.vhd scr_regs.vhd devices.vhd mem.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
cover: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd tod.vhd timer.vhd fetch_stats.vhd sd_regs.vhd net_regs.vhd eth_regs.vhd sd_spi_byte.vhd sd_spi.vhd sd.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd uart_pkg.vhd bus_pkg.vhd board_io.vhd scr_regs.vhd devices.vhd mem.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
rom: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true -gG_ROM_FILE=rom.bin -gG_BOARD_IO=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd tod.vhd timer.vhd fetch_stats.vhd sd_regs.vhd net_regs.vhd eth_regs.vhd sd_spi_byte.vhd sd_spi.vhd sd.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd uart_pkg.vhd bus_pkg.vhd board_io.vhd scr_regs.vhd devices.vhd mem.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
rom_cover: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true -gG_ROM_FILE=rom.bin -gG_BOARD_IO=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd tod.vhd timer.vhd fetch_stats.vhd sd_regs.vhd net_regs.vhd eth_regs.vhd sd_spi_byte.vhd sd_spi.vhd sd.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd uart_pkg.vhd bus_pkg.vhd board_io.vhd scr_regs.vhd devices.vhd mem.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
sd: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true -gG_SD_SLOTS=2 nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd tod.vhd timer.vhd fetch_stats.vhd sd_regs.vhd net_regs.vhd eth_regs.vhd sd_spi_byte.vhd sd_spi.vhd sd.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd uart_pkg.vhd bus_pkg.vhd board_io.vhd scr_regs.vhd devices.vhd mem.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
sd_cover: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true -gG_SD_SLOTS=2 nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd tod.vhd timer.vhd fetch_stats.vhd sd_regs.vhd net_regs.vhd eth_regs.vhd sd_spi_byte.vhd sd_spi.vhd sd.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd uart_pkg.vhd bus_pkg.vhd board_io.vhd scr_regs.vhd devices.vhd mem.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
prep -top formal_nicemon

