# The whole system (formal_nicemon.vhd), with the checks of nicemon.vhd. It
# is too large for k-induction, so "run" and "link" check every cycle up to
# their depth: "run" with the core running from reset, "link" with the core
# held first, for the link. "cover" reaches each cover statement. These
# three have no ROM and no board registers. "rom" and "rom_cover" are "run"
# and "cover" with both: a ROM of 4 words, rom.bin, and the Nexys4DDR's
# registers at 0xFFFFFF90-9F.
# The core is nice_core_formal.vhd, a free core that does anything either
# of nice_cpu's cores may do on its ports, so the system is checked against
# both, and the solver spends nothing on a real core's state. The debug
# link is debug_link_formal.vhd, a free link that does anything that
# nice_cpu's debug_link.vhd may do, so it makes a request in any cycle,
# where a real one needs hundreds of cycles of UART bytes for one. Its
# assumptions are the contracts of debug_link.vhd, which nice_cpu proves
# in nice_cpu/hdl/formal/debug_link.sby.
# The link uses the bus only while the core is held or halted, and a
# halted core makes no new fetch, so no link request meets a running core
# or an outstanding fetch.

[tasks]
run
link
cover
rom
rom_cover

[options]
run: mode bmc
run: depth 30
link: mode bmc
link: depth 40
cover: mode cover
cover: depth 40
rom: mode bmc
rom: depth 30
rom_cover: mode cover
rom_cover: depth 40

[engines]
smtbmc yices

[script]
plugin -i ghdl
run: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd timer.vhd fetch_stats.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
link: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=false nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd timer.vhd fetch_stats.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
cover: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd timer.vhd fetch_stats.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
rom: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true -gG_ROM_FILE=rom.bin -gG_BOARD_IO=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd timer.vhd fetch_stats.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
rom_cover: ghdl --std=08 -fpsl -gG_CPU_RUN_AT_RESET=true -gG_ROM_FILE=rom.bin -gG_BOARD_IO=true nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd mpu.vhd perf.vhd timer.vhd fetch_stats.vhd nice_core.vhd nice_core_formal.vhd uart_serdes.vhd debug_link.vhd debug_link_formal.vhd rx_fifo.vhd ram.vhd rom.vhd nicemon.vhd formal_nicemon.vhd -e formal_nicemon
prep -top formal_nicemon

[files]
../nice_cpu/hdl/src/nice_pkg.vhd
../nice_cpu/hdl/src/trace_pkg.vhd
../nice_cpu/hdl/src/pipe_pkg.vhd
../nice_cpu/hdl/src/mpu.vhd
../nice_cpu/hdl/src/perf.vhd
../nice_cpu/hdl/src/timer.vhd
../nice_cpu/hdl/src/fetch_stats.vhd
../src/nice_core.vhd
../src/uart_serdes.vhd
../nice_cpu/hdl/src/debug_link.vhd
../src/rx_fifo.vhd
../src/ram.vhd
../src/rom.vhd
../src/nicemon.vhd
nice_core_formal.vhd
debug_link_formal.vhd
formal_nicemon.vhd
rom.bin
