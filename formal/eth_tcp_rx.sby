# The parser of the TCP server's received frames, src/eth/eth_tcp_rx.vhd
# (formal_eth_tcp_rx.vhd). "prove" proves the assertions for every cycle
# by k-induction, and "cover" reaches each cover statement, a good segment
# with its checksums among them. The depths are in cycles: 8 is the k of
# the induction, and 64 is how far "cover" looks, past the 54 bytes of a
# segment's headers.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 64

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl eth_pkg.vhd eth_tcp_rx.vhd formal_eth_tcp_rx.vhd -e formal_eth_tcp_rx
prep -top formal_eth_tcp_rx

[files]
../src/eth/eth_pkg.vhd
../src/eth/eth_tcp_rx.vhd
formal_eth_tcp_rx.vhd
