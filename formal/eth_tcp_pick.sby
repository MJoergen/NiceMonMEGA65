# The choice of the TCP server's segments, src/eth/eth_tcp_pick.vhd
# (formal_eth_tcp_pick.vhd), with the sender, src/eth/eth_tcp_tx.vhd, under
# it. "prove" proves the assertions for every cycle by k-induction, and
# "cover" reaches each cover statement. The depths are in cycles: 8 is the
# k of the induction, and 12 is how far "cover" looks for each statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl eth_pkg.vhd eth_tcp_tx.vhd eth_tcp_pick.vhd formal_eth_tcp_pick.vhd -e formal_eth_tcp_pick
prep -top formal_eth_tcp_pick

[files]
../src/eth/eth_pkg.vhd
../src/eth/eth_tcp_tx.vhd
../src/eth/eth_tcp_pick.vhd
formal_eth_tcp_pick.vhd
