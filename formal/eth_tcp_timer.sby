# The TCP server's retransmission timer, src/eth/eth_tcp_timer.vhd
# (formal_eth_tcp_timer.vhd). "prove" proves the assertions for every cycle
# by k-induction, and "cover" reaches each cover statement. The depths are
# in cycles: 12 is the k of the induction, and 40 is how far "cover" looks
# for each statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 40

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl eth_tcp_timer.vhd formal_eth_tcp_timer.vhd -e formal_eth_tcp_timer
prep -top formal_eth_tcp_timer

[files]
../src/eth/eth_tcp_timer.vhd
formal_eth_tcp_timer.vhd
