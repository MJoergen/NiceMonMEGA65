10 SIZE = 8190
20 DIM FLAGS(8191)
30 PRINT "1 ITERATION"
40 COUNT = 0
50 FOR I = 0 TO SIZE
60 FLAGS(I) = 1
70 NEXT I
80 FOR I = 0 TO SIZE
90 IF FLAGS(I) = 0 THEN 180
100 PRIME = I + I + 3
110 K = I + PRIME
120 IF K > SIZE THEN 170
130 FLAGS(K) = 0
140 K = K + PRIME
150 GOTO 120
170 COUNT = COUNT + 1
180 NEXT I
190 PRINT COUNT; " PRIMES"
