10 REM STAGE 4: "QUOTES" AND ? STAY
20 FOR I = 1 TO 3: ? I;: NEXT: PRINT
30 PRINT "X=";.5;1E20;0x1F;-2; 7 DIV 2
40 IF I > 3 THEN 60 ELSE GOTO 50
50 GOSUB 70: END
60 DIM A(3): A(1) = I: PRINT A(1): GOTO 50
70 RETURN
SAVE "PROG"
NEW
LIST
LOAD "PROG"
LIST
RUN
X = 5
RUN "PROG"
? X
LOAD "pc"
LIST
RUN
LOAD "BAD"
LIST
LOAD "LONG"
LIST
LOAD "WIDE"
LOAD "HIGH"
LIST
LOAD "NONE"
LIST
RUN "NONE"
LIST
SAVE "T.TXT"
LOAD "T.TXT"
LIST
NEW
SAVE "EMPTY"
LOAD "EMPTY"
LIST
RUN "HELLO.BIN"
RUN "PROG", 1
LOAD "PROG", 0
SAVE "S", 0
BSAVE "W", 0x8000, 2, 0
BSAVE "W", 0x8000, 2, 5
LOAD "W.BIN", 2
DELETE "W.BIN", "1.2.3.4"
DELETE "W.BIN", 0
DELETE "S.BAS", 0
RUN "PROG", "1.2.3.4" X
10 RUN "PC"
RUN
SAVE "P", "1.2.3.4"
SAVE "BRK"
LOAD "BRK"
LIST
NEW
10 TRAP 100
20 BSAVE "W", 0x8000, 2, 1
30 LOAD "NOPE.BIN", 0
40 DELETE "NOPE.BIN"
50 END
100 PRINT ER, EL, DS, ERR$(ER): PRINT DS$: RESUME NEXT
RUN
10 LOAD "NOPE.BIN"
RUN
NEW
10 TRAP 100: LOAD "NOPE": PRINT "NEXT"
20 RUN "NOPE": PRINT "NEXT"
30 END
100 PRINT ER, EL, DS, ERR$(ER): PRINT DS$: RESUME NEXT
RUN
LIST
10 TRAP 100: LOAD "BAD": PRINT "NOT HERE"
RUN
LIST
NEW
DIR
HALT
