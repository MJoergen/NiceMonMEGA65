10 REM A VERY SIMPLE CHESS PROGRAM IN BASIC, AFTER NICE_CHESS
20 REM NEGAMAX WITH ALPHA-BETA AND A TIME LIMIT, MATERIAL AND SQUARES
30 TL = 10: REM THE SECONDS THAT THE COMPUTER THINKS ON A MOVE
40 GOSUB 9000
50 PRINT "CHESS IN BASIC"
60 INPUT "PLAY WHITE, BLACK, OR NONE (W/B/N)"; A$
70 A$ = LEFT$(A$, 1): HU = 0
80 IF A$ = "W" OR A$ = "w" THEN HU = 1
90 IF A$ = "B" OR A$ = "b" THEN HU = -1
100 REM THE GAME: THE BOARD, THE LEGAL MOVES, AND A MOVE OF ONE SIDE
110 GOSUB 2000
120 T = K%(S + 1): A = -S: GOSUB 7000: IC = AT: N = 0: QS = 0: GOSUB 4000: LN = 0: IF N = 0 THEN 150
130 FOR J = 0 TO N - 1: MV = M%(J): GOSUB 6000: GOSUB 5700: GOSUB 6500: IF AT = 0 THEN LM%(LN) = MV: LN = LN + 1
140 NEXT J
150 IF S = 1 THEN W$ = "BLACK" ELSE W$ = "WHITE"
160 IF LN > 0 THEN 200
180 IF IC THEN PRINT "CHECKMATE, "; W$; " WINS": END
190 PRINT "STALEMATE, A DRAW": END
200 IF FI >= 100 THEN PRINT "A DRAW BY THE FIFTY-MOVE RULE": END
210 IF NP = 0 OR (NP = 1 AND NM = 1) THEN PRINT "A DRAW, AS NEITHER SIDE CAN MATE": END
220 IF IC THEN PRINT "CHECK"
230 IF S = HU THEN GOSUB 2500 ELSE GOSUB 3000
240 GOSUB 2600: IF S = 1 THEN PRINT GP DIV 2 + 1; ". "; M$ ELSE PRINT GP DIV 2 + 1; "... "; M$
250 GOSUB 6000: H = 0: GP = GP + 1: GOTO 110
2000 REM THE BOARD, WHITE AT THE BOTTOM, AND THE PIECES LEFT
2010 PRINT: NP = 0: NM = 0
2020 FOR R = 8 TO 1 STEP -1: L$ = STR$(R) + " "
2030 FOR F = 1 TO 8: X = B%(10 * R + 10 + F): L$ = L$ + " " + MID$("kqrbnp.PNBRQK", X + 7, 1)
2040 IF X <> 0 AND ABS(X) <> 6 THEN NP = NP + 1: IF ABS(X) = 2 OR ABS(X) = 3 THEN NM = NM + 1
2050 NEXT F: PRINT L$: NEXT R
2060 PRINT "   a b c d e f g h": RETURN
2500 REM THE PLAYER'S MOVE, SUCH AS e2e4, OR e7e8q, INTO MV
2510 INPUT "YOUR MOVE"; A$: IF LEN(A$) < 4 THEN 2590
2520 FM = (ASC(A$) OR 32) - 96 + 10 * (VAL(MID$(A$, 2, 1)) + 1)
2530 TM = (ASC(MID$(A$, 3, 1)) OR 32) - 96 + 10 * (VAL(MID$(A$, 4, 1)) + 1)
2540 PR = 5: IF LEN(A$) > 4 THEN C = INSTR("NBRQnbrq", MID$(A$, 5, 1)): IF C > 0 THEN PR = (C - 1) MOD 4 + 2
2550 FOR J = 0 TO LN - 1: MV = LM%(J)
2560 IF (MV AND 127) = FM AND ((MV >> 7) AND 127) = TM THEN IF MV < 16384 OR MV >> 14 = PR THEN RETURN
2570 NEXT J
2590 PRINT "NOT A LEGAL MOVE; TYPE IT AS e2e4, OR e7e8q": GOTO 2510
2600 REM THE MOVE MV AS TEXT IN M$, SUCH AS e2e4
2610 FM = MV AND 127: TM = (MV >> 7) AND 127
2620 M$ = CHR$(96 + FM MOD 10) + CHR$(47 + FM DIV 10) + CHR$(96 + TM MOD 10) + CHR$(47 + TM DIV 10)
2630 IF MV >= 16384 THEN M$ = M$ + MID$("nbrq", (MV >> 14) - 1, 1)
2640 RETURN
3000 REM THE COMPUTER'S MOVE INTO MV, DEEPER AND DEEPER UNTIL THE TIME IS UP
3010 MV = LM%(0): BB = 0: IF LN = 1 THEN RETURN
3020 T0 = TI: TE = T0 + TL * 1000000: ST = 0: NO = 0: ID = 0
3030 ID = ID + 1: PL = 0: MS%(0) = 0: AL%(0) = -32000: BE%(0) = 32000: DP%(0) = ID: BM%(0) = MV: GOSUB 5000
3040 MV = BM%(0): IF ST THEN RETURN
3050 BB = MV: BV = V: GOSUB 2600
3060 PRINT "DEPTH "; ID; ", SCORE "; BV; ", "; M$; ", NODES "; NO; ", "; INT((TI - T0) / 100000) / 10; " S"
3070 IF ABS(BV) < 29000 AND ID < 30 AND TI - T0 < TL * 500000 THEN 3030
3080 RETURN
4000 REM THE MOVES OF THE SIDE S INTO M%(N) UP, AND THEIR ORDER INTO MO%
4010 REM CAPTURES AND PROMOTIONS ALONE WHEN QS IS 1; IC IS 1 IN CHECK
4020 O1 = 8 - 8 * S: F = 10 * S: SR = (11 - 5 * S) / 2: PZ = (11 + 7 * S) / 2
4025 FOR I = O1 TO O1 + 15: FR = PQ%(I): IF FR = 0 THEN 4180
4030 P = B%(FR) * S: IF P = 1 THEN 4200
4040 SL = SL%(P): IF QS THEN 4100
4050 FOR K = DA%(P) TO DZ%(P): D = DR%(K): T = FR
4060 T = T + D: X = B%(T): IF X = 0 THEN M%(N) = FR + 128 * T: MO%(N) = 0: N = N + 1: IF SL THEN 4060
4065 IF X <> 0 THEN IF X <> 7 THEN IF X * S < 0 THEN M%(N) = FR + 128 * T: MO%(N) = 16 * ABS(X) - P: N = N + 1
4070 NEXT K: GOTO 4180
4100 FOR K = DA%(P) TO DZ%(P): D = DR%(K): T = FR
4110 T = T + D: X = B%(T): IF X = 0 THEN IF SL THEN 4110
4120 IF X <> 0 THEN IF X <> 7 THEN IF X * S < 0 THEN M%(N) = FR + 128 * T: MO%(N) = 16 * ABS(X) - P: N = N + 1
4130 NEXT K
4180 NEXT I
4190 IF QS = 0 THEN GOSUB 4400
4195 RETURN
4200 REM A PAWN: ITS PUSHES, ITS CAPTURES, AND EN PASSANT; SR AND PZ ARE ITS RANKS
4205 T = FR + F: IF B%(T) THEN 4240
4210 IF T DIV 10 = PZ THEN X = 0: GOSUB 4300: GOTO 4240
4220 IF QS = 0 THEN M%(N) = FR + 128 * T: MO%(N) = 0: N = N + 1: IF FR DIV 10 = SR THEN IF B%(T + F) = 0 THEN M%(N) = FR + 128 * (T + F): MO%(N) = 0: N = N + 1
4240 T = T - 1: X = B%(T): IF X * S < 0 THEN IF X <> 7 THEN GOSUB 4280
4250 T = T + 2: X = B%(T): IF X * S < 0 THEN IF X <> 7 THEN GOSUB 4280
4260 IF EP THEN IF ABS(EP - FR - F) = 1 THEN M%(N) = FR + 128 * EP: MO%(N) = 15: N = N + 1
4270 GOTO 4180
4280 IF T DIV 10 = PZ THEN GOSUB 4300: RETURN
4290 M%(N) = FR + 128 * T: MO%(N) = 16 * ABS(X) - 1: N = N + 1: RETURN
4300 REM A PROMOTION TO FR + 128 * T, OF A QUEEN, AND OF THE OTHERS BUT IN QS
4310 C = FR + 128 * T: VX = 16 * ABS(X): M%(N) = C + 5 * 16384: MO%(N) = VX + 90: N = N + 1: IF QS THEN RETURN
4320 FOR Q = 2 TO 4: M%(N) = C + Q * 16384: MO%(N) = VX: N = N + 1: NEXT Q: RETURN
4400 REM CASTLING: THE SQUARES BETWEEN EMPTY, AND THE KING NOT IN CHECK NOR PASSING ONE
4410 IF S = 1 THEN KQ = 25: CK = 1: CQ = 2 ELSE KQ = 95: CK = 4: CQ = 8
4420 IF B%(KQ) <> 6 * S THEN RETURN
4430 IF (CR AND CK) = 0 OR B%(KQ + 1) <> 0 OR B%(KQ + 2) <> 0 OR B%(KQ + 3) <> 4 * S THEN 4460
4440 IF IC = 0 THEN A = -S: T = KQ + 1: GOSUB 7000: IF AT = 0 THEN M%(N) = KQ + 128 * (KQ + 2): MO%(N) = 0: N = N + 1
4460 IF (CR AND CQ) = 0 OR B%(KQ - 1) <> 0 OR B%(KQ - 2) <> 0 OR B%(KQ - 3) <> 0 OR B%(KQ - 4) <> 4 * S THEN RETURN
4470 IF IC = 0 THEN A = -S: T = KQ - 1: GOSUB 7000: IF AT = 0 THEN M%(N) = KQ + 128 * (KQ - 2): MO%(N) = 0: N = N + 1
4480 RETURN
5000 REM THE NEGAMAX SEARCH OF THE NODE AT PLY PL, ITS SCORE INTO V
5010 NO = NO + 1: IF (NO AND 15) = 0 THEN IF TI > TE THEN ST = 1
5020 IF ST THEN V = 0: RETURN
5030 IF DP%(PL) < 1 THEN 5400
5040 IF PL > 0 AND FI >= 100 THEN V = 0: RETURN
5050 T = K%(S + 1): A = -S: GOSUB 7000: IC = AT: IC%(PL) = AT: N = MS%(PL): QS = 0: GOSUB 4000: BS%(PL) = -32000: IF PL = 0 THEN GOSUB 5600
5060 ME%(PL) = N: MS%(PL + 1) = N: MI%(PL) = MS%(PL): OF%(PL) = 1: LC%(PL) = 0
5100 IF MI%(PL) >= ME%(PL) THEN 5300
5110 GOSUB 8000: MV = M%(MI%(PL)): MI%(PL) = MI%(PL) + 1: GOSUB 6000
5120 IC = IC%(PL): GOSUB 5700
5125 IF AT THEN GOSUB 6500: GOTO 5100
5130 LC%(PL) = LC%(PL) + 1: P1 = PL + 1: AL%(P1) = -BE%(PL): BE%(P1) = -AL%(PL): DP%(P1) = DP%(PL) - 1
5135 PL = P1: GOSUB 5000: PL = PL - 1: V = -V: GOSUB 6500
5140 IF ST THEN RETURN
5150 IF V <= BS%(PL) THEN 5100
5160 BS%(PL) = V: BM%(PL) = M%(MI%(PL) - 1): IF V > AL%(PL) THEN AL%(PL) = V
5170 IF V < BE%(PL) THEN 5100
5180 RETURN
5300 IF LC%(PL) > 0 OR DP%(PL) < 1 THEN V = BS%(PL): RETURN
5310 IF IC%(PL) THEN V = -30000 + PL: RETURN
5320 V = 0: RETURN
5400 REM THE QUIESCENCE SEARCH: THE SCORE AS IT STANDS, OR A CAPTURE
5410 GOSUB 7500: IF PL >= 40 OR V >= BE%(PL) THEN RETURN
5420 BS%(PL) = V: IF V > AL%(PL) THEN AL%(PL) = V
5430 N = MS%(PL): QS = 1: GOSUB 4000: IF N > MS%(PL) THEN T = K%(S + 1): A = -S: GOSUB 7000: IC%(PL) = AT
5440 GOTO 5060
5600 REM AT THE ROOT, THE BEST MOVE OF THE LAST DEPTH FIRST
5610 IF BB = 0 THEN RETURN
5620 FOR J = 0 TO N - 1: IF M%(J) = BB THEN MO%(J) = 30000
5630 NEXT J: RETURN
5700 REM AFTER A MOVE, AT = 1 WHEN IT LEFT ITS KING IN CHECK: IN CHECK BEFORE IT,
5710 REM OF THE KING, OR EN PASSANT, ANY CHECK; ELSE ONE FROM BEHIND THE SQUARE FM
5720 IF IC OR LG THEN T = K%(1 - S): A = S: GOTO 7000
5730 GOTO 7200
6000 REM MAKE THE MOVE MV, AND KEEP WHAT UNDOES IT AT H, OF THE SEARCH'S PLIES
6010 FM = MV AND 127: TM = (MV >> 7) AND 127: PR = MV >> 14: P = B%(FM): X = B%(TM): LG = 0
6020 HM%(H) = MV: HC%(H) = X: HR%(H) = CR: HE%(H) = EP: HF%(H) = FI: HS%(H) = SC: HP%(H) = PH: HI%(H) = IX%(TM): H = H + 1
6030 SC = SC - PV%(P + 6, FM) + PV%(P + 6, TM) - PV%(X + 6, TM): B%(TM) = P: B%(FM) = 0: FI = FI + 1: Y = IX%(FM): PQ%(Y) = TM: IX%(TM) = Y
6040 IF X THEN FI = 0: PH = PH - PW%(ABS(X)): PQ%(HI%(H - 1)) = 0
6050 CR = CR AND CM%(FM) AND CM%(TM): E2 = EP: EP = 0
6060 IF P = S THEN 6100
6070 IF P = 6 * S THEN LG = 1: K%(S + 1) = TM: IF ABS(TM - FM) = 2 THEN GOSUB 6200
6080 S = -S: RETURN
6100 FI = 0: IF TM = E2 THEN LG = 1: U = TM - 10 * S: B%(U) = 0: SC = SC - PV%(6 - S, U): Y = IX%(U): HI%(H - 1) = Y: PQ%(Y) = 0
6110 IF ABS(TM - FM) = 20 THEN EP = FM + 10 * S
6120 IF PR THEN B%(TM) = PR * S: SC = SC - PV%(S + 6, TM) + PV%(PR * S + 6, TM): PH = PH + PW%(PR)
6130 S = -S: RETURN
6200 IF TM > FM THEN RF = FM + 3: RT = FM + 1 ELSE RF = FM - 4: RT = FM - 1
6210 R = B%(RF): B%(RT) = R: B%(RF) = 0: SC = SC - PV%(R + 6, RF) + PV%(R + 6, RT): Y = IX%(RF): PQ%(Y) = RT: IX%(RT) = Y: RETURN
6500 REM UNMAKE THE LAST MOVE
6510 H = H - 1: S = -S: MV = HM%(H): FM = MV AND 127: TM = (MV >> 7) AND 127: P = B%(TM): IF MV >= 16384 THEN P = S
6520 B%(FM) = P: X = HC%(H): B%(TM) = X: CR = HR%(H): EP = HE%(H): FI = HF%(H): SC = HS%(H): PH = HP%(H): Y = IX%(TM): PQ%(Y) = FM: IX%(FM) = Y
6525 IF X THEN Y = HI%(H): PQ%(Y) = TM: IX%(TM) = Y
6530 IF P = S THEN IF TM = EP THEN U = TM - 10 * S: B%(U) = -S: Y = HI%(H): PQ%(Y) = U: IX%(U) = Y
6540 IF P = 6 * S THEN K%(S + 1) = FM: IF ABS(TM - FM) = 2 THEN GOSUB 6600
6550 RETURN
6600 IF TM > FM THEN RF = FM + 3: RT = FM + 1 ELSE RF = FM - 4: RT = FM - 1
6610 B%(RF) = B%(RT): B%(RT) = 0: Y = IX%(RT): PQ%(Y) = RF: IX%(RF) = Y: RETURN
7000 REM AT = 1 WHEN THE SIDE A ATTACKS THE SQUARE T, ELSE 0
7010 AT = 1: U = T - 10 * A: IF B%(U - 1) = A OR B%(U + 1) = A THEN RETURN
7020 FOR Z = 0 TO 7: IF B%(T + DR%(Z)) = 2 * A THEN RETURN
7030 NEXT Z
7040 FOR Z = 8 TO 15: IF B%(T + DR%(Z)) = 6 * A THEN RETURN
7050 NEXT Z
7060 FOR Z = 8 TO 11: D2 = DR%(Z): U = T + D2
7070 W = B%(U): IF W = 0 THEN U = U + D2: GOTO 7070
7080 IF W = 3 * A OR W = 5 * A THEN RETURN
7090 NEXT Z
7100 FOR Z = 12 TO 15: D2 = DR%(Z): U = T + D2
7110 W = B%(U): IF W = 0 THEN U = U + D2: GOTO 7110
7120 IF W = 4 * A OR W = 5 * A THEN RETURN
7130 NEXT Z
7140 AT = 0: RETURN
7200 REM AT = 1 WHEN THE SIDE S ATTACKS THE KING OF -S THROUGH THE SQUARE FM
7210 KK = K%(1 - S): DF = FM MOD 10 - KK MOD 10: DQ = FM DIV 10 - KK DIV 10: AT = 0
7220 IF DF <> 0 AND DQ <> 0 AND ABS(DF) <> ABS(DQ) THEN RETURN
7230 D3 = SGN(DQ) * 10 + SGN(DF): U = KK + D3
7240 W = B%(U): IF W = 0 THEN U = U + D3: GOTO 7240
7250 IF W = 7 THEN RETURN
7260 W = W * S: IF W = 5 THEN AT = 1: RETURN
7270 IF DF = 0 OR DQ = 0 THEN IF W = 4 THEN AT = 1
7280 IF DF <> 0 AND DQ <> 0 THEN IF W = 3 THEN AT = 1
7290 RETURN
7500 REM THE SCORE FOR THE SIDE S INTO V: SC, AND THE KINGS BY THE PHASE
7510 Q1 = PH: IF Q1 > 24 THEN Q1 = 24
7520 V = (K1%(K%(2)) - K1%(MR%(K%(0)))) * Q1 + (K2%(K%(2)) - K2%(MR%(K%(0)))) * (24 - Q1)
7530 V = (SC + V DIV 24) * S: RETURN
8000 REM PUT THE BEST CAPTURE LEFT AT MI%(PL), UNTIL NONE IS LEFT
8010 IF OF%(PL) = 0 THEN RETURN
8020 J0 = MI%(PL): XI = J0: XB = MO%(J0): IF J0 + 1 >= ME%(PL) THEN RETURN
8030 FOR J = J0 + 1 TO ME%(PL) - 1: IF MO%(J) > XB THEN XB = MO%(J): XI = J
8040 NEXT J: IF XB <= 0 THEN OF%(PL) = 0: RETURN
8050 IF XI = J0 THEN RETURN
8060 Y = M%(J0): M%(J0) = M%(XI): M%(XI) = Y: Y = MO%(J0): MO%(J0) = MO%(XI): MO%(XI) = Y: RETURN
9000 REM THE TABLES, AND THE BOARD AT THE START: 10 BY 12 SQUARES, A1 IS 21
9010 DIM B%(119), SQ%(63), DR%(15), DA%(6), DZ%(6), SL%(6), PV%(12, 119), CM%(119), K1%(119), K2%(119), MR%(119), PW%(6)
9020 DIM M%(2000), MO%(2000), MS%(50), ME%(50), MI%(50), OF%(50), LC%(50), AL%(50), BE%(50), DP%(50), BS%(50), BM%(50)
9030 DIM HM%(50), HC%(50), HR%(50), HE%(50), HF%(50), HS%(50), HP%(50), HI%(50), K%(2), LM%(255)
9035 DIM PQ%(31), IX%(119), IC%(50)
9040 FOR I = 0 TO 119: B%(I) = 7: CM%(I) = 15: MR%(I) = (11 - I DIV 10) * 10 + I MOD 10: NEXT I
9050 FOR I = 0 TO 63: SQ%(I) = 21 + 10 * (I DIV 8) + I MOD 8: B%(SQ%(I)) = 0: NEXT I
9060 FOR F = 1 TO 8: READ Q: B%(20 + F) = Q: B%(90 + F) = -Q: B%(30 + F) = 1: B%(80 + F) = -1: NEXT F
9070 FOR I = 0 TO 15: READ DR%(I): NEXT I
9080 FOR P = 1 TO 6: READ DA%(P), DZ%(P), SL%(P), PW%(P): NEXT P
9090 CM%(21) = 13: CM%(25) = 12: CM%(28) = 14: CM%(91) = 7: CM%(95) = 3: CM%(98) = 11
9100 FOR P = 1 TO 5: READ VL: FOR I = 0 TO 63: READ D: Q = 21 + 10 * (7 - I DIV 8) + I MOD 8
9110 PV%(6 + P, Q) = VL + D: PV%(6 - P, MR%(Q)) = -VL - D: NEXT I: NEXT P
9120 FOR I = 0 TO 63: READ D: K1%(21 + 10 * (7 - I DIV 8) + I MOD 8) = D: NEXT I
9130 FOR I = 0 TO 63: READ D: K2%(21 + 10 * (7 - I DIV 8) + I MOD 8) = D: NEXT I
9140 K%(2) = 25: K%(0) = 95: S = 1: CR = 15: EP = 0: FI = 0: H = 0: GP = 0: SC = 0: PH = 0
9150 FOR I = 0 TO 63: X = B%(SQ%(I)): SC = SC + PV%(X + 6, SQ%(I)): PH = PH + PW%(ABS(X)): NEXT I
9155 NW = 0: NB = 16: FOR I = 0 TO 63: Q = SQ%(I): X = B%(Q): IF X > 0 THEN PQ%(NW) = Q: IX%(Q) = NW: NW = NW + 1
9156 IF X < 0 THEN PQ%(NB) = Q: IX%(Q) = NB: NB = NB + 1
9157 NEXT I
9160 RETURN
