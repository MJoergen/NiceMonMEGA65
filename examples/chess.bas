  10 REM A VERY SIMPLE CHESS PROGRAM IN BASIC, AFTER NICE_CHESS
  20 REM NEGAMAX WITH ALPHA-BETA AND A TIME LIMIT, MATERIAL AND SQUARES
  30 THINKSECONDS = 10: REM THE SECONDS THAT THE COMPUTER THINKS ON A MOVE
  40 MAXDEPTH = 30: REM THE DEEPEST SEARCH, IN PLIES, BEFORE THE CAPTURES
  50 PROCSETUP
  60 PRINT "CHESS IN BASIC"
  70 INPUT "PLAY WHITE, BLACK, OR NONE (W/B/N)"; ANSWER$
  80 ANSWER$ = LEFT$(ANSWER$, 1): HUMANSIDE = 0
  90 IF ANSWER$ = "W" OR ANSWER$ = "w" THEN HUMANSIDE = 1
 100 IF ANSWER$ = "B" OR ANSWER$ = "b" THEN HUMANSIDE = -1
 110 DO
 120  PROCSHOWBOARD
 130  PROCLEGALMOVES
 140  RESULT$ = FNRESULT$
 150  IF RESULT$ <> "" THEN PRINT RESULT$: EXIT
 160  IF INCHECK THEN PRINT "CHECK"
 170  IF SIDE = HUMANSIDE THEN PROCHUMANMOVE ELSE PROCCOMPUTERMOVE
 180  IF SIDE = 1 THEN DOTS$ = ". " ELSE DOTS$ = "... "
 190  PRINT HALFMOVES DIV 2 + 1; DOTS$; FNMOVETEXT$(MOVE)
 200  PROCMAKEMOVE(MOVE): UNDOCOUNT = 0: HALFMOVES = HALFMOVES + 1
 210 LOOP
 220 END
 230 REM
 240 REM THE BOARD IS 10 BY 12 SQUARES, A1 IS 21, WITH A BORDER OF 7S. A PIECE
 250 REM IS 1 TO 6, PAWN TO KING, POSITIVE FOR WHITE AND NEGATIVE FOR BLACK.
 260 REM SIDE IS THE SIDE TO MOVE, 1 OR -1. A MOVE IS ITS SQUARE FROM, PLUS
 270 REM 128 TIMES ITS SQUARE TO, PLUS 16384 TIMES ITS PIECE OF PROMOTION.
 280 REM
 290 REM THE BOARD, WHITE AT THE BOTTOM
 300 DEF PROCSHOWBOARD
 310  LOCAL RANK, FILE, ROW$
 320  PRINT
 330  FOR RANK = 8 TO 1 STEP -1
 340   ROW$ = STR$(RANK) + " "
 350   FOR FILE = 1 TO 8
 360    ROW$ = ROW$ + " " + MID$("kqrbnp.PNBRQK", BOARD%(10 * RANK + 10 + FILE) + 7, 1)
 370   NEXT FILE
 380   PRINT ROW$
 390  NEXT RANK
 400  PRINT "   a b c d e f g h"
 410 ENDPROC
 420 REM
 430 REM HOW THE GAME HAS ENDED, OR "" WHILE IT GOES ON
 440 DEF FNRESULT$
 450  LOCAL WINNER$, SLOT, KIND, PIECES, MINORS
 460  IF SIDE = 1 THEN WINNER$ = "BLACK" ELSE WINNER$ = "WHITE"
 470  IF LEGALCOUNT = 0 THEN IF INCHECK THEN = "CHECKMATE, " + WINNER$ + " WINS" ELSE = "STALEMATE, A DRAW"
 480  IF FIFTY >= 100 THEN = "A DRAW BY THE FIFTY-MOVE RULE"
 490  FOR SLOT = 0 TO 31
 500   IF PIECELIST%(SLOT) THEN KIND = ABS(BOARD%(PIECELIST%(SLOT))): IF KIND <> 6 THEN PIECES = PIECES + 1: IF KIND = 2 OR KIND = 3 THEN MINORS = MINORS + 1
 510  NEXT SLOT
 520  IF PIECES = 0 OR (PIECES = 1 AND MINORS = 1) THEN = "A DRAW, AS NEITHER SIDE CAN MATE"
 530 = ""
 540 REM
 550 REM THE LEGAL MOVES OF SIDE INTO LEGALMOVE%, AND INCHECK
 560 DEF PROCLEGALMOVES
 570  LOCAL CANDIDATE
 580  INCHECK = FNATTACKED(KINGSQUARE%(SIDE + 1), -SIDE)
 590  MOVEEND = 0: CAPTURESONLY = 0: PROCGENERATE
 600  LEGALCOUNT = 0
 610  DO WHILE CANDIDATE < MOVEEND
 620   PROCMAKEMOVE(MOVES%(CANDIDATE))
 630   IF FNLEFTINCHECK = 0 THEN LEGALMOVE%(LEGALCOUNT) = MOVES%(CANDIDATE): LEGALCOUNT = LEGALCOUNT + 1
 640   PROCUNMAKEMOVE
 650   CANDIDATE = CANDIDATE + 1
 660  LOOP
 670 ENDPROC
 680 REM
 690 REM THE PLAYER'S MOVE, SUCH AS e2e4, OR e7e8q, INTO MOVE
 700 DEF PROCHUMANMOVE
 710  LOCAL TYPED$
 720  DO
 730   INPUT "YOUR MOVE"; TYPED$
 740   MOVE = FNPARSEMOVE(TYPED$)
 750   IF MOVE = 0 THEN PRINT "NOT A LEGAL MOVE; TYPE IT AS e2e4, OR e7e8q"
 760  LOOP UNTIL MOVE
 770 ENDPROC
 780 REM
 790 REM THE LEGAL MOVE THAT TEXT$ NAMES, OR 0; A QUEEN WHEN NO PIECE IS NAMED
 800 DEF FNPARSEMOVE(TEXT$)
 810  LOCAL FROMSQUARE, TOSQUARE, PROMOTION, LETTER, INDEX, CANDIDATE
 820  IF LEN(TEXT$) < 4 THEN = 0
 830  FROMSQUARE = FNSQUARE(TEXT$): TOSQUARE = FNSQUARE(MID$(TEXT$, 3))
 840  PROMOTION = 5
 850  IF LEN(TEXT$) > 4 THEN LETTER = INSTR("NBRQnbrq", MID$(TEXT$, 5, 1)): IF LETTER > 0 THEN PROMOTION = (LETTER - 1) MOD 4 + 2
 860  FOR INDEX = 0 TO LEGALCOUNT - 1
 870   CANDIDATE = LEGALMOVE%(INDEX)
 880   IF FNFROM(CANDIDATE) = FROMSQUARE AND FNTO(CANDIDATE) = TOSQUARE THEN IF CANDIDATE < 16384 OR CANDIDATE >> 14 = PROMOTION THEN = CANDIDATE
 890  NEXT INDEX
 900 = 0
 910 REM
 920 REM A SQUARE, SUCH AS e2, AND BACK
 930 DEF FNSQUARE(NAME$) = (ASC(NAME$) OR 32) - 96 + 10 * (VAL(MID$(NAME$, 2, 1)) + 1)
 940 DEF FNSQUARENAME$(SQUARE) = CHR$(96 + SQUARE MOD 10) + CHR$(47 + SQUARE DIV 10)
 950 REM
 960 REM A MOVE'S SQUARES, AND THE MOVE AS TEXT, SUCH AS e2e4 OR e7e8q
 970 DEF FNFROM(CODE) = CODE AND 127
 980 DEF FNTO(CODE) = (CODE >> 7) AND 127
 990 DEF FNMOVETEXT$(CODE)
1000  LOCAL TEXT$
1010  TEXT$ = FNSQUARENAME$(FNFROM(CODE)) + FNSQUARENAME$(FNTO(CODE))
1020  IF CODE >= 16384 THEN TEXT$ = TEXT$ + MID$("nbrq", (CODE >> 14) - 1, 1)
1030 = TEXT$
1040 REM
1050 REM THE COMPUTER'S MOVE INTO MOVE, DEEPER AND DEEPER UNTIL THE TIME IS UP
1060 DEF PROCCOMPUTERMOVE
1070  MOVE = LEGALMOVE%(0): PREVIOUSBEST = 0
1080 IF LEGALCOUNT = 1 THEN ENDPROC
1090 STARTTIME = TI: ENDTIME = STARTTIME + THINKSECONDS * 1000000
1100 STOPPED = 0: NODES = 0: ITERATION = 0
1110 DO
1120  ITERATION = ITERATION + 1: PLY = 0: PLYSTART%(0) = 0
1130  ALPHA%(0) = -32000: BETA%(0) = 32000: DEPTH%(0) = ITERATION: BESTMOVE%(0) = MOVE
1140  PROCSEARCH
1150  MOVE = BESTMOVE%(0)
1160  IF STOPPED THEN EXIT
1170  PREVIOUSBEST = MOVE: BESTVALUE = VALUE
1180  PRINT "DEPTH "; ITERATION; ", SCORE "; BESTVALUE; ", "; FNMOVETEXT$(MOVE); ", NODES "; NODES; ", "; INT((TI - STARTTIME) / 100000) / 10; " S"
1190 LOOP WHILE ABS(BESTVALUE) < 29000 AND ITERATION < MAXDEPTH AND TI - STARTTIME < THINKSECONDS * 500000
1200 ENDPROC
1210 REM
1220 REM THE NEGAMAX SEARCH OF THE NODE AT PLY, ITS SCORE INTO VALUE. A PLY'S
1230 REM STATE IS IN THE ARRAYS, AS PARAMETERS WOULD TAKE MORE OF THE FRAMES.
1240 REM AT DEPTH 0 THE QUIESCENCE SEARCH: THE SCORE AS IT STANDS, OR A CAPTURE.
1250 DEF PROCSEARCH
1260  NODES = NODES + 1
1270  IF (NODES AND 15) = 0 THEN IF TI > ENDTIME THEN STOPPED = 1
1280 IF STOPPED THEN VALUE = 0: ENDPROC
1290 IF DEPTH%(PLY) < 1 THEN
1300  VALUE = FNEVALUATE
1310 IF PLY >= MAXPLY OR VALUE >= BETA%(PLY) THEN ENDPROC
1320 BESTSCORE%(PLY) = VALUE: IF VALUE > ALPHA%(PLY) THEN ALPHA%(PLY) = VALUE
1330 MOVEEND = PLYSTART%(PLY): CAPTURESONLY = 1: PROCGENERATE
1340 IF MOVEEND > PLYSTART%(PLY) THEN PLYINCHECK%(PLY) = FNATTACKED(KINGSQUARE%(SIDE + 1), -SIDE)
1350 ELSE
1360 IF PLY > 0 AND FIFTY >= 100 THEN VALUE = 0: ENDPROC
1370 INCHECK = FNATTACKED(KINGSQUARE%(SIDE + 1), -SIDE): PLYINCHECK%(PLY) = INCHECK
1380 MOVEEND = PLYSTART%(PLY): CAPTURESONLY = 0: PROCGENERATE
1390 BESTSCORE%(PLY) = -32000: IF PLY = 0 THEN PROCLASTBEST1ST
1400 ENDIF
1410 PLYEND%(PLY) = MOVEEND: PLYSTART%(PLY + 1) = MOVEEND
1420 PLYNEXT%(PLY) = PLYSTART%(PLY): PLYSORTING%(PLY) = 1: PLYLEGAL%(PLY) = 0
1430 DO WHILE PLYNEXT%(PLY) < PLYEND%(PLY)
1440  PROCPICKCAPTURE
1450  PROCMAKEMOVE(MOVES%(PLYNEXT%(PLY))): PLYNEXT%(PLY) = PLYNEXT%(PLY) + 1
1460  INCHECK = PLYINCHECK%(PLY)
1470  IF FNLEFTINCHECK THEN
1480   PROCUNMAKEMOVE
1490  ELSE
1500   PLYLEGAL%(PLY) = PLYLEGAL%(PLY) + 1
1510   ALPHA%(PLY + 1) = -BETA%(PLY): BETA%(PLY + 1) = -ALPHA%(PLY): DEPTH%(PLY + 1) = DEPTH%(PLY) - 1
1520   PLY = PLY + 1: PROCSEARCH: PLY = PLY - 1: VALUE = -VALUE
1530   PROCUNMAKEMOVE
1540  IF STOPPED THEN ENDPROC
1550  IF VALUE > BESTSCORE%(PLY) THEN
1560   BESTSCORE%(PLY) = VALUE: BESTMOVE%(PLY) = MOVES%(PLYNEXT%(PLY) - 1)
1570   IF VALUE > ALPHA%(PLY) THEN ALPHA%(PLY) = VALUE
1580  IF VALUE >= BETA%(PLY) THEN ENDPROC
1590 ENDIF
1600 ENDIF
1610 LOOP
1620 VALUE = BESTSCORE%(PLY)
1630 IF PLYLEGAL%(PLY) = 0 AND DEPTH%(PLY) >= 1 THEN IF PLYINCHECK%(PLY) THEN VALUE = -30000 + PLY ELSE VALUE = 0
1640 ENDPROC
1650 REM
1660 REM AT THE ROOT, THE BEST MOVE OF THE LAST DEPTH FIRST
1670 DEF PROCLASTBEST1ST
1680  LOCAL INDEX
1690 IF PREVIOUSBEST = 0 THEN ENDPROC
1700 FOR INDEX = 0 TO MOVEEND - 1: IF MOVES%(INDEX) = PREVIOUSBEST THEN MOVEORDER%(INDEX) = 30000
1710 NEXT INDEX
1720 ENDPROC
1730 REM
1740 REM THE BEST CAPTURE LEFT TO PLYNEXT% OF THE PLY, THE MOST VALUABLE VICTIM
1750 REM FIRST, UNTIL NONE IS LEFT; THE QUIET MOVES THEN COME IN THEIR ORDER
1760 DEF PROCPICKCAPTURE
1770 IF PLYSORTING%(PLY) = 0 THEN ENDPROC
1780 FIRST = PLYNEXT%(PLY): PICKED = FIRST: PICKEDORDER = MOVEORDER%(FIRST)
1790 IF FIRST + 1 >= PLYEND%(PLY) THEN ENDPROC
1800 FOR SCAN = FIRST + 1 TO PLYEND%(PLY) - 1: IF MOVEORDER%(SCAN) > PICKEDORDER THEN PICKEDORDER = MOVEORDER%(SCAN): PICKED = SCAN
1810 NEXT SCAN
1820 IF PICKEDORDER <= 0 THEN PLYSORTING%(PLY) = 0: ENDPROC
1830 IF PICKED = FIRST THEN ENDPROC
1840 SWAP = MOVES%(FIRST): MOVES%(FIRST) = MOVES%(PICKED): MOVES%(PICKED) = SWAP
1850 SWAP = MOVEORDER%(FIRST): MOVEORDER%(FIRST) = MOVEORDER%(PICKED): MOVEORDER%(PICKED) = SWAP
1860 ENDPROC
1870 REM
1880 REM THE MOVES OF SIDE INTO MOVES% FROM MOVEEND UP, AND THEIR ORDER INTO
1890 REM MOVEORDER%: 16 TIMES THE VICTIM LESS THE PIECE FOR A CAPTURE. THE
1900 REM CAPTURES AND PROMOTIONS ALONE WHEN CAPTURESONLY IS 1. THE MOVES MAY
1910 REM LEAVE THE KING IN CHECK; FNLEFTINCHECK DROPS THOSE.
1920 DEF PROCGENERATE
1930  FIRSTSLOT = 8 - 8 * SIDE: FORWARD = 10 * SIDE
1940  STARTRANK = (11 - 5 * SIDE) / 2: PROMOTERANK = (11 + 7 * SIDE) / 2
1950  FOR GENSLOT = FIRSTSLOT TO FIRSTSLOT + 15
1960   FROMSQUARE = PIECELIST%(GENSLOT)
1970   IF FROMSQUARE THEN
1980    PIECE = BOARD%(FROMSQUARE) * SIDE
1990    IF PIECE = 1 THEN
2000     PROCPAWNMOVES
2010    ELSE
2020     SLIDING = SLIDES%(PIECE)
2030     FOR RAY = FIRSTDIR%(PIECE) TO LASTDIR%(PIECE)
2040      RAYSTEP = DIRECTION%(RAY): TOSQUARE = FROMSQUARE
2050      DO
2060       TOSQUARE = TOSQUARE + RAYSTEP: TARGET = BOARD%(TOSQUARE)
2070       IF TARGET THEN EXIT
2080       IF CAPTURESONLY = 0 THEN PROCADDMOVE(FROMSQUARE + 128 * TOSQUARE, 0)
2090      LOOP WHILE SLIDING
2100      IF TARGET * SIDE < 0 AND TARGET <> 7 THEN PROCADDMOVE(FROMSQUARE + 128 * TOSQUARE, 16 * ABS(TARGET) - PIECE)
2110     NEXT RAY
2120    ENDIF
2130   ENDIF
2140  NEXT GENSLOT
2150  IF CAPTURESONLY = 0 THEN PROCCASTLING
2160 ENDPROC
2170 REM
2180 REM A MOVE AND ITS ORDER ADDED TO THE LIST
2190 DEF PROCADDMOVE(CODE, ORDER)
2200  MOVES%(MOVEEND) = CODE: MOVEORDER%(MOVEEND) = ORDER: MOVEEND = MOVEEND + 1
2210 ENDPROC
2220 REM
2230 REM A PAWN'S PUSHES, ITS CAPTURES, AND EN PASSANT
2240 DEF PROCPAWNMOVES
2250  TOSQUARE = FROMSQUARE + FORWARD
2260  IF BOARD%(TOSQUARE) = 0 THEN
2270   IF TOSQUARE DIV 10 = PROMOTERANK THEN
2280    TARGET = 0: PROCPROMOTIONS
2290   ELSE
2300    IF CAPTURESONLY = 0 THEN
2310     PROCADDMOVE(FROMSQUARE + 128 * TOSQUARE, 0)
2320     IF FROMSQUARE DIV 10 = STARTRANK THEN IF BOARD%(TOSQUARE + FORWARD) = 0 THEN PROCADDMOVE(FROMSQUARE + 128 * (TOSQUARE + FORWARD), 0)
2330    ENDIF
2340   ENDIF
2350  ENDIF
2360  FOR TOSQUARE = FROMSQUARE + FORWARD - 1 TO FROMSQUARE + FORWARD + 1 STEP 2
2370   TARGET = BOARD%(TOSQUARE)
2380   IF TARGET * SIDE < 0 AND TARGET <> 7 THEN IF TOSQUARE DIV 10 = PROMOTERANK THEN PROCPROMOTIONS ELSE PROCADDMOVE(FROMSQUARE + 128 * TOSQUARE, 16 * ABS(TARGET) - 1)
2390  NEXT TOSQUARE
2400  IF ENPASSANT THEN IF ABS(ENPASSANT - FROMSQUARE - FORWARD) = 1 THEN PROCADDMOVE(FROMSQUARE + 128 * ENPASSANT, 15)
2410 ENDPROC
2420 REM
2430 REM A PAWN'S MOVE TO THE LAST RANK: A QUEEN, AND THE OTHERS BUT IN THE
2440 REM CAPTURES ALONE; TARGET IS WHAT IT TAKES
2450 DEF PROCPROMOTIONS
2460  LOCAL PROMOTION
2470  PROCADDMOVE(FROMSQUARE + 128 * TOSQUARE + 5 * 16384, 16 * ABS(TARGET) + 90)
2480 IF CAPTURESONLY THEN ENDPROC
2490 FOR PROMOTION = 2 TO 4
2500  PROCADDMOVE(FROMSQUARE + 128 * TOSQUARE + PROMOTION * 16384, 16 * ABS(TARGET))
2510 NEXT PROMOTION
2520 ENDPROC
2530 REM
2540 REM CASTLING: THE SQUARES BETWEEN EMPTY, AND THE KING NOT IN CHECK NOR
2550 REM PASSING ONE; THE SQUARE THAT IT ENDS ON IS THE SEARCH'S TEST
2560 DEF PROCCASTLING
2570  LOCAL HOME, SHORT, LONG
2580  IF SIDE = 1 THEN HOME = 25: SHORT = 1: LONG = 2 ELSE HOME = 95: SHORT = 4: LONG = 8
2590 IF BOARD%(HOME) <> 6 * SIDE OR INCHECK THEN ENDPROC
2600 IF CASTLING AND SHORT THEN
2610  IF BOARD%(HOME + 1) = 0 AND BOARD%(HOME + 2) = 0 AND BOARD%(HOME + 3) = 4 * SIDE THEN
2620   IF FNATTACKED(HOME + 1, -SIDE) = 0 THEN PROCADDMOVE(HOME + 128 * (HOME + 2), 0)
2630  ENDIF
2640 ENDIF
2650 IF CASTLING AND LONG THEN
2660  IF BOARD%(HOME - 1) = 0 AND BOARD%(HOME - 2) = 0 AND BOARD%(HOME - 3) = 0 AND BOARD%(HOME - 4) = 4 * SIDE THEN
2670   IF FNATTACKED(HOME - 1, -SIDE) = 0 THEN PROCADDMOVE(HOME + 128 * (HOME - 2), 0)
2680  ENDIF
2690 ENDIF
2700 ENDPROC
2710 REM
2720 REM 1 WHEN THE MOVE JUST MADE LEFT ITS KING IN CHECK: IN CHECK BEFORE IT,
2730 REM OF THE KING, OR EN PASSANT, ANY CHECK; ELSE ONE THROUGH ITS SQUARE FROM
2740 DEF FNLEFTINCHECK
2750  IF INCHECK OR FULLCHECK THEN = FNATTACKED(KINGSQUARE%(1 - SIDE), SIDE)
2760 = FNEXPOSED
2770 REM
2780 REM 1 WHEN THE SIDE BY ATTACKS THE SQUARE, ELSE 0
2790 DEF FNATTACKED(SQUARE, BY)
2800  IF BOARD%(SQUARE - 10 * BY - 1) = BY OR BOARD%(SQUARE - 10 * BY + 1) = BY THEN = 1
2810  FOR ATTACK = 0 TO 7: IF BOARD%(SQUARE + DIRECTION%(ATTACK)) = 2 * BY THEN = 1
2820  NEXT ATTACK
2830  FOR ATTACK = 8 TO 15: IF BOARD%(SQUARE + DIRECTION%(ATTACK)) = 6 * BY THEN = 1
2840  NEXT ATTACK
2850  FOR ATTACK = 8 TO 15
2860   RAYSTEP = DIRECTION%(ATTACK): RAYSQUARE = SQUARE
2870   DO: RAYSQUARE = RAYSQUARE + RAYSTEP: RAYPIECE = BOARD%(RAYSQUARE): LOOP UNTIL RAYPIECE
2880   IF RAYPIECE = 5 * BY THEN = 1
2890   IF ATTACK < 12 THEN IF RAYPIECE = 3 * BY THEN = 1
2900   IF ATTACK >= 12 THEN IF RAYPIECE = 4 * BY THEN = 1
2910  NEXT ATTACK
2920 = 0
2930 REM
2940 REM 1 WHEN SIDE ATTACKS THE KING OF -SIDE ALONG THE LINE THROUGH FROMSQUARE
2950 DEF FNEXPOSED
2960  KINGAT = KINGSQUARE%(1 - SIDE)
2970  FILEDIFF = FROMSQUARE MOD 10 - KINGAT MOD 10: RANKDIFF = FROMSQUARE DIV 10 - KINGAT DIV 10
2980  IF FILEDIFF <> 0 AND RANKDIFF <> 0 AND ABS(FILEDIFF) <> ABS(RANKDIFF) THEN = 0
2990  RAYSTEP = SGN(RANKDIFF) * 10 + SGN(FILEDIFF): RAYSQUARE = KINGAT + RAYSTEP
3000  DO WHILE BOARD%(RAYSQUARE) = 0: RAYSQUARE = RAYSQUARE + RAYSTEP: LOOP
3010  RAYPIECE = BOARD%(RAYSQUARE) * SIDE
3020  IF RAYPIECE = 5 THEN = 1
3030  IF FILEDIFF = 0 OR RANKDIFF = 0 THEN = -(RAYPIECE = 4)
3040 = -(RAYPIECE = 3)
3050 REM
3060 REM THE SCORE FOR SIDE: SCORE, AND THE KINGS' SQUARES MIXED BY THE PHASE
3070 DEF FNEVALUATE
3080  WEIGHT = PHASE: IF WEIGHT > 24 THEN WEIGHT = 24
3090  KINGS = (KINGMIDDLE%(KINGSQUARE%(2)) - KINGMIDDLE%(MIRROR%(KINGSQUARE%(0)))) * WEIGHT
3100  KINGS = KINGS + (KINGEND%(KINGSQUARE%(2)) - KINGEND%(MIRROR%(KINGSQUARE%(0)))) * (24 - WEIGHT)
3110 = (SCORE + KINGS DIV 24) * SIDE
3120 REM
3130 REM MAKE THE MOVE, AND KEEP WHAT UNDOES IT AT UNDOCOUNT; FULLCHECK IS 1
3140 REM AFTER A MOVE OF THE KING OR EN PASSANT
3150 DEF PROCMAKEMOVE(CODE)
3160  FROMSQUARE = FNFROM(CODE): TOSQUARE = FNTO(CODE): PROMOTION = CODE >> 14
3170  PIECE = BOARD%(FROMSQUARE): CAPTURED = BOARD%(TOSQUARE): FULLCHECK = 0
3180  UNDOMOVE%(UNDOCOUNT) = CODE: UNDOCAPTURED%(UNDOCOUNT) = CAPTURED: UNDOCASTLING%(UNDOCOUNT) = CASTLING
3190  UNDOENPASSANT%(UNDOCOUNT) = ENPASSANT: UNDOFIFTY%(UNDOCOUNT) = FIFTY: UNDOSCORE%(UNDOCOUNT) = SCORE
3200  UNDOPHASE%(UNDOCOUNT) = PHASE: UNDOSLOT%(UNDOCOUNT) = LISTSLOT%(TOSQUARE): UNDOCOUNT = UNDOCOUNT + 1
3210  SCORE = SCORE - SQUAREVALUE%(PIECE + 6, FROMSQUARE) + SQUAREVALUE%(PIECE + 6, TOSQUARE) - SQUAREVALUE%(CAPTURED + 6, TOSQUARE)
3220  BOARD%(TOSQUARE) = PIECE: BOARD%(FROMSQUARE) = 0: FIFTY = FIFTY + 1
3230  SLOT = LISTSLOT%(FROMSQUARE): PIECELIST%(SLOT) = TOSQUARE: LISTSLOT%(TOSQUARE) = SLOT
3240  IF CAPTURED THEN FIFTY = 0: PHASE = PHASE - PHASEWEIGHT%(ABS(CAPTURED)): PIECELIST%(UNDOSLOT%(UNDOCOUNT - 1)) = 0
3250  CASTLING = CASTLING AND CASTLEMASK%(FROMSQUARE) AND CASTLEMASK%(TOSQUARE)
3260  OLDENPASSANT = ENPASSANT: ENPASSANT = 0
3270  IF PIECE = SIDE THEN
3280   FIFTY = 0
3290   IF TOSQUARE = OLDENPASSANT THEN
3300    FULLCHECK = 1: VICTIMSQUARE = TOSQUARE - 10 * SIDE: BOARD%(VICTIMSQUARE) = 0
3310    SCORE = SCORE - SQUAREVALUE%(6 - SIDE, VICTIMSQUARE)
3320    SLOT = LISTSLOT%(VICTIMSQUARE): UNDOSLOT%(UNDOCOUNT - 1) = SLOT: PIECELIST%(SLOT) = 0
3330   ENDIF
3340   IF ABS(TOSQUARE - FROMSQUARE) = 20 THEN ENPASSANT = FROMSQUARE + 10 * SIDE
3350   IF PROMOTION THEN
3360    BOARD%(TOSQUARE) = PROMOTION * SIDE: PHASE = PHASE + PHASEWEIGHT%(PROMOTION)
3370    SCORE = SCORE - SQUAREVALUE%(SIDE + 6, TOSQUARE) + SQUAREVALUE%(PROMOTION * SIDE + 6, TOSQUARE)
3380   ENDIF
3390  ENDIF
3400  IF PIECE = 6 * SIDE THEN
3410   FULLCHECK = 1: KINGSQUARE%(SIDE + 1) = TOSQUARE
3420   IF ABS(TOSQUARE - FROMSQUARE) = 2 THEN
3430    IF TOSQUARE > FROMSQUARE THEN ROOKFROM = FROMSQUARE + 3: ROOKTO = FROMSQUARE + 1 ELSE ROOKFROM = FROMSQUARE - 4: ROOKTO = FROMSQUARE - 1
3440    ROOK = BOARD%(ROOKFROM)
3450    SCORE = SCORE - SQUAREVALUE%(ROOK + 6, ROOKFROM) + SQUAREVALUE%(ROOK + 6, ROOKTO)
3460    PROCMOVEROOK(ROOKFROM, ROOKTO)
3470   ENDIF
3480  ENDIF
3490  SIDE = -SIDE
3500 ENDPROC
3510 REM
3520 REM UNMAKE THE LAST MOVE
3530 DEF PROCUNMAKEMOVE
3540  UNDOCOUNT = UNDOCOUNT - 1: SIDE = -SIDE: CODE = UNDOMOVE%(UNDOCOUNT)
3550  FROMSQUARE = FNFROM(CODE): TOSQUARE = FNTO(CODE)
3560  PIECE = BOARD%(TOSQUARE): IF CODE >= 16384 THEN PIECE = SIDE
3570  CAPTURED = UNDOCAPTURED%(UNDOCOUNT): BOARD%(FROMSQUARE) = PIECE: BOARD%(TOSQUARE) = CAPTURED
3580  CASTLING = UNDOCASTLING%(UNDOCOUNT): ENPASSANT = UNDOENPASSANT%(UNDOCOUNT): FIFTY = UNDOFIFTY%(UNDOCOUNT)
3590  SCORE = UNDOSCORE%(UNDOCOUNT): PHASE = UNDOPHASE%(UNDOCOUNT)
3600  SLOT = LISTSLOT%(TOSQUARE): PIECELIST%(SLOT) = FROMSQUARE: LISTSLOT%(FROMSQUARE) = SLOT
3610  IF CAPTURED THEN SLOT = UNDOSLOT%(UNDOCOUNT): PIECELIST%(SLOT) = TOSQUARE: LISTSLOT%(TOSQUARE) = SLOT
3620  IF PIECE = SIDE AND TOSQUARE = ENPASSANT THEN
3630   VICTIMSQUARE = TOSQUARE - 10 * SIDE: BOARD%(VICTIMSQUARE) = -SIDE
3640   SLOT = UNDOSLOT%(UNDOCOUNT): PIECELIST%(SLOT) = VICTIMSQUARE: LISTSLOT%(VICTIMSQUARE) = SLOT
3650  ENDIF
3660  IF PIECE = 6 * SIDE THEN
3670   KINGSQUARE%(SIDE + 1) = FROMSQUARE
3680   IF ABS(TOSQUARE - FROMSQUARE) = 2 THEN IF TOSQUARE > FROMSQUARE THEN PROCMOVEROOK(FROMSQUARE + 1, FROMSQUARE + 3) ELSE PROCMOVEROOK(FROMSQUARE - 1, FROMSQUARE - 4)
3690  ENDIF
3700 ENDPROC
3710 REM
3720 REM THE ROOK OF A CASTLING, ON THE BOARD AND IN THE LIST OF PIECES
3730 DEF PROCMOVEROOK(SOURCE, DESTINATION)
3740  BOARD%(DESTINATION) = BOARD%(SOURCE): BOARD%(SOURCE) = 0
3750  SLOT = LISTSLOT%(SOURCE): PIECELIST%(SLOT) = DESTINATION: LISTSLOT%(DESTINATION) = SLOT
3760 ENDPROC
3770 REM
3780 REM THE TABLES, AND THE BOARD AT THE START
3790 DEF PROCSETUP
3800  LOCAL INDEX, FILE, KIND, WORTH, BONUS, SQUARE, WHITES, BLACKS
3810  MAXPLY = 32: REM THE DEEPEST PLY OF THE QUIESCENCE SEARCH, FOR THE FRAMES
3820  DIM BOARD%(119), BOARDSQUARE%(63), DIRECTION%(15), FIRSTDIR%(6), LASTDIR%(6), SLIDES%(6), PHASEWEIGHT%(6)
3830  DIM SQUAREVALUE%(12, 119), CASTLEMASK%(119), KINGMIDDLE%(119), KINGEND%(119), MIRROR%(119)
3840  DIM MOVES%(2000), MOVEORDER%(2000), LEGALMOVE%(255), KINGSQUARE%(2), PIECELIST%(31), LISTSLOT%(119)
3850  DIM PLYSTART%(50), PLYEND%(50), PLYNEXT%(50), PLYSORTING%(50), PLYLEGAL%(50), PLYINCHECK%(50)
