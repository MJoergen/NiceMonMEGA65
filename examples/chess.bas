4150   IF KIND > 0 THEN PIECELIST%(WHITES) = SQUARE: LISTSLOT%(SQUARE) = WHITES: WHITES = WHITES + 1
4160   IF KIND < 0 THEN PIECELIST%(BLACKS) = SQUARE: LISTSLOT%(SQUARE) = BLACKS: BLACKS = BLACKS + 1
4170  NEXT INDEX
4180 ENDPROC
