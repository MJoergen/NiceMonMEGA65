10 REM THE SIEVE OF ERATOSTHENES IN BASIC, THEN IN MACHINE CODE
20 REM SIEVE.BIN LIVES ABOVE HIMEM, WHERE BASIC NEVER WRITES
30 HIMEM = 0xC000
40 LOAD "SIEVE.BIN"
50 SIZE = 8190
60 DIM F%(SIZE)
70 PRINT "BASIC:"
80 T = TI
90 C = 0
100 FOR I = 0 TO SIZE: F%(I) = 1: NEXT I
110 FOR I = 0 TO SIZE
120 IF F%(I) = 0 THEN 190
130 P = I + I + 3
140 K = I + P
150 IF K > SIZE THEN 180
160 F%(K) = 0: K = K + P
170 GOTO 150
180 C = C + 1
190 NEXT I
200 B = TI - T
210 PRINT C; " PRIMES IN "; INT(B / 1000); " MS"
220 PRINT "MACHINE CODE:"
230 POKE 0xC000, SIZE
240 T = TI
250 SYS 0xC002
260 M = TI - T
270 PRINT PEEK(0xC001); " PRIMES IN "; INT(M / 1000); " MS"
280 PRINT "MACHINE CODE IS "; INT(B / M); " TIMES AS FAST"
